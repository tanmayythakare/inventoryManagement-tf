# ==============================================================================
# Production .gitignore for Cloud DevOps Platform & Three-Tier Workload
# ==============================================================================

# OS & Environment
.DS_Store
Thumbs.db
*.env
*.env.local
*.env.*.local

# IDE & Editor Specific
.idea/
.vscode/
.agents/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~

# Java / Maven (Backend)
backend/target/
backend/.mvn/timing.properties
backend/.flattened-pom.xml
*.class
*.jar
*.war
*.ear

# Node / Angular (Frontend)
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Terraform Local State & Artifacts
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Security & Secrets (Always Guard Against Accidental Commit)
*.pem
*.key
*.p12
*.pfx
secrets.tfvars
terraform.tfvars.local

# CI/CD & Scan Reports
trufflehog-report.json
trivy-*.json
bom.json
junit-*.xml
coverage/
